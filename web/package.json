{
  "name": "ember-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vite build && APP_DIR=\"$PWD/dist\" ../prototype/run-tests.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node build/join.js && eslint .",
    "typecheck": "tsc -p .",
    "test:unit": "node --test \"test/*.test.mjs\"",
    "test:scanner": "vite build --logLevel error && node test/browser/scanner.e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "eslint": "10.15.0",
    "eslint-scope": "9.1.2",
    "espree": "11.2.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "@zxing/library": "0.21.3",
    "fflate": "0.8.2"
  }
}
