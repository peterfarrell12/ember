{
  "name": "ember-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vite build && APP_DIR=\"$PWD/dist\" ../prototype/run-tests.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && git diff --exit-code src/app/module-globals.d.ts && npm run typecheck && npm run test:unit",
    "lint": "node build/join.js && eslint .",
    "typecheck": "tsc -p .",
    "test:unit": "node --test \"test/*.test.mjs\"",
    "test:scanner": "vite build --logLevel error && node test/browser/scanner.e2e.mjs",
    "test:onboarding": "vite build --logLevel error && node test/browser/onboarding.e2e.mjs",
    "test:voice": "vite build --logLevel error && node test/browser/voice.e2e.mjs",
    "native:assets": "capacitor-assets generate --ios --android --iconBackgroundColor \"#0f3d2e\" --iconBackgroundColorDark \"#0f3d2e\" --splashBackgroundColor \"#0f3d2e\" --splashBackgroundColorDark \"#0f3d2e\"",
    "native:sync": "vite build && cap sync"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "eslint": "10.15.0",
    "eslint-scope": "9.1.2",
    "espree": "11.2.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-speech-recognition": "8.6.0",
    "@supabase/supabase-js": "2.119.2",
    "@zxing/library": "0.21.3",
    "fflate": "0.8.2"
  }
}
